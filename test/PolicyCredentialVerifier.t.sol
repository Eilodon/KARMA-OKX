pragma solidity ^0.8.24;

import {Test} from "forge-std/Test.sol";
import {PolicyCredentialVerifier} from "../contracts/policy/PolicyCredentialVerifier.sol";

/// @notice Not a mock-data test: `VALID_A`/`VALID_B`/`VALID_C`/`VALID_PUB_SIGNALS` below are the
///         literal Solidity calldata (`snarkjs zkey export soliditycalldata`) for a REAL Groth16
///         proof generated by `circuits/test/policy_credential.test.mjs`'s happy-path run against
///         `circuits/src/policy_credential.circom` — a genuine ZK proof of "I hold a credential
///         committed under this issuer root with reputationScore >= 60", verified here by the
///         actual BN254 pairing precompile on an EVM, not a stub. Public signals, in order:
///         [policyRequestId=111, domain=222, minReputation=60, nullifier, credentialCommitment,
///         issuerRoot]. Regenerate via circuits/README.md's "PolicyCredentialProof" section if
///         `policy_credential.circom` or its trusted setup ever changes — these values are tied
///         to that exact circuit + ceremony, not derived here.
contract PolicyCredentialVerifierTest is Test {
    PolicyCredentialVerifier internal verifier;

    function setUp() public {
        verifier = new PolicyCredentialVerifier();
    }

    function _validProof() internal pure returns (uint256[2] memory a, uint256[2][2] memory b, uint256[2] memory c, uint256[6] memory pub) {
        a = [
            0x033d2caa682a2509ea1e24b0477b94632a757b679a0dbc366994fd04f7890850,
            0x09e26a4fecae68b5b4161b6961f3d7e6f1179552d4a2c1105c9b58d262317cfc
        ];
        b = [
            [
                0x01a1701cdcab5c28fa4b8f32a2bf5e91b87e99b088ff27067799e54984d692cc,
                0x0401cab7e47eca8027609bca10a905dd25114307a4600102f94989b870442ccb
            ],
            [
                0x28240d0fa2643825d852d9dbdabdbfd61c48d5204663a5ec95a08a11b2c5a756,
                0x18451886d85a1f5cfe40483cfbfcd47270b3394c2f982e0c813bc3bd2ad49f65
            ]
        ];
        c = [
            0x275e53779a8f22d19a84dcedcf2a840480e6a6cc8c9c2933542badd8022a6aa6,
            0x0adc538abc2dbad0ab51a69e80b1a4220a8ef8075ef70080889d9647f3c31bb9
        ];
        pub = [
            uint256(111), // policyRequestId
            uint256(222), // domain
            uint256(60), // minReputation
            0x20d196770f80eb1844db64c4f1c8933302b5b558b1bae2d879ea9e5e7e5b206a, // nullifier
            0x04fc0a1f6b54c75958261d468910f0231c495eb9229ee262d7048c508a9e7211, // credentialCommitment
            0x1665a6d455fb59641944762ee77b419d992929e17ac981f334f388bce45b2c87 // issuerRoot
        ];
    }

    /// @dev The actual point: a proof generated entirely off-chain by the circom/snarkjs pipeline
    ///      verifies as `true` against real EVM precompiles, with zero mocking on either side.
    function test_VerifiesRealProof_FromCircuitTestSuite() public {
        (uint256[2] memory a, uint256[2][2] memory b, uint256[2] memory c, uint256[6] memory pub) = _validProof();
        assertTrue(verifier.verifyProof(a, b, c, pub), "real circuit-generated proof must verify");
    }

    function test_RejectsProof_WithTamperedPublicSignal() public {
        (uint256[2] memory a, uint256[2][2] memory b, uint256[2] memory c, uint256[6] memory pub) = _validProof();
        pub[2] = 0; // claim minReputation=0 instead of the actual 60 the proof was generated for
        assertFalse(verifier.verifyProof(a, b, c, pub), "tampered public signal must not verify");
    }

    function test_RejectsProof_WithDifferentPolicyRequestId() public {
        (uint256[2] memory a, uint256[2][2] memory b, uint256[2] memory c, uint256[6] memory pub) = _validProof();
        pub[0] = 999; // a different policyRequestId than the one this proof actually binds to
        assertFalse(verifier.verifyProof(a, b, c, pub), "a proof for one policyRequestId must not verify for another");
    }

    function test_RejectsProof_WithMangledProofPoint() public {
        (uint256[2] memory a, uint256[2][2] memory b, uint256[2] memory c, uint256[6] memory pub) = _validProof();
        a[0] = a[0] + 1;
        assertFalse(verifier.verifyProof(a, b, c, pub), "a mangled curve point must not verify");
    }
}
